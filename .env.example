# --- Site ---
NEXT_PUBLIC_SITE_URL=https://gastropass.app

# --- Supabase ---
# Public, browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Apple Wallet (PassKit) ---
# PEM contents, base64-encoded, or file paths depending on deployment target.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_IDENTIFIER=pass.app.gastropass.loyalty
APPLE_WWDR_CERTIFICATE=
APPLE_SIGNER_CERTIFICATE=
APPLE_SIGNER_KEY=
APPLE_SIGNER_KEY_PASSPHRASE=

# --- Apple Push Notification service (APNs) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_TOPIC=pass.app.gastropass.loyalty
APNS_ENVIRONMENT=production

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# --- Security ---
# Symmetric secret for signing internal webhook/API payloads.
WEBHOOK_SIGNING_SECRET=
